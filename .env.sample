#
# Configuration for the Makefile front-end.  Copy this file to .env
# (`make config`) and adjust the values for your setup.  The Makefile loads
# .env automatically; values already present in the environment take priority.

# Target platform (informational label only).
QCOM_PLATFORM=kodiak

# Absolute path to the hardware *_security_profile.xml.
# Required by: sign-build, gen-fuse-blower.
QCOM_SEC_PROFILE=/path/to/kodiak_security_profile.xml

# Signing keys.  `make generate-keys` always writes them to ./OEM-KEYS; point
# QCOM_ROT_KEYS at an existing key directory if you generated them elsewhere.
# QCOM_FMP_KEYS defaults to $(QCOM_ROT_KEYS)/demoCA.
QCOM_ROT_KEYS=OEM-KEYS
#QCOM_FMP_KEYS=OEM-KEYS/demoCA

# Number of root certificates and which CA key index to sign with.
# Defaults match the scripts; override only for multi-root key setups.
QCOM_ROOT_CERT_TOTALNUM=1
QCOM_SIGNING_KEY_INDEX=0

# Password applied to all FMP keys.  Required by: generate-keys.
QCOM_FMP_KEY_PASSWORD=

# Directory containing the images to sign (the "flat build").
# Required by: sign-build (and used as the output dir for gen-fuse-blower).
QCOM_FLAT_BUILD=/path/to/flat_build

# Output folder: sign-build copies the flat build here and signs the copies,
# leaving the originals untouched.  VIP tables are written inside it.
# Defaults to ./signed-build next to the Makefile.
QCOM_SIGNED_BUILD=signed-build

# Optional: directory with UEFI signing keys (DB.key / DB.crt).
#QCOM_UEFI_KEYS=/path/to/uefi/keys

# sectools: leave QCOM_SECTOOLS empty to auto-fetch the pinned version into
# ./.sectools/<version>/.  Set it to an existing binary to skip downloading.
QCOM_SECTOOLS=
QCOM_SECTOOLS_VERSION=1.45
#QCOM_SECTOOLS_DIR=.sectools
#QCOM_SECTOOLS_URL=

# VIP (Validated Image Programming) tables.  After signing the build,
# sign-build also generates and signs a VIP table of digests, unless
# QCOM_VIP_DISABLE is set.
#QCOM_VIP_DISABLE=1
# VIP output dir; defaults to inside the signed build folder.
QCOM_VIP_DIR=$(QCOM_SIGNED_BUILD)/vip-tables
QCOM_FIREHOSE=prog_firehose_ddr.elf

# Target storage type for `make flash` (emmc|nand|nvme|spinor|ufs).
QCOM_STORAGE=ufs

# qdl (used to create VIP tables): leave QCOM_QDL empty to clone the pinned
# git ref (branch or tag, e.g. v2.7) and build it (meson + ninja) into
# ./.qdl/<ref>/.
QCOM_QDL=
QCOM_QDL_VERSION=master
#QCOM_QDL_REPO=https://github.com/linux-msm/qdl.git

# Fuse identifiers.  Required by: gen-fuse-blower.
QCOM_FUSE_OEM_HW_ID=
QCOM_FUSE_OEM_PRODUCT_ID=
QCOM_FUSE_SEC_KEY_DERIVATION_KEY=
