#
# Makefile configuration.  Copy to .env (`make config`) and edit.
# Values given on the make command line take priority.

# Security profile: a bare filename is fetched from
# https://github.com/qualcomm/security-profiles; a path is used as-is.
# Required by: sign-build, gen-fuse-blower.
QCOM_SEC_PROFILE=kodiak_security_profile.xml
#QCOM_SEC_PROFILES_DIR=.security-profiles
#QCOM_SEC_PROFILES_REV=

# Signing keys (`make generate-keys` writes ./OEM-KEYS).
# QCOM_FMP_KEYS defaults to $(QCOM_ROT_KEYS)/demoCA.
QCOM_ROT_KEYS=OEM-KEYS
#QCOM_FMP_KEYS=OEM-KEYS/demoCA
QCOM_ROOT_CERT_TOTALNUM=1
QCOM_SIGNING_KEY_INDEX=0

# Password for the FMP keys.  Required by: generate-keys.
QCOM_FMP_KEY_PASSWORD=

# Directory with the images to sign.  Required by: sign-build.
QCOM_FLAT_BUILD=/path/to/flat_build

# sign-build copies QCOM_FLAT_BUILD here and signs the copies.
QCOM_SIGNED_BUILD=signed-build

# Optional: UEFI signing keys (DB.key / DB.crt).
#QCOM_UEFI_KEYS=/path/to/uefi/keys

# sectools: empty QCOM_SECTOOLS fetches QCOM_SECTOOLS_VERSION into
# ./.sectools/<version>/ (see https://softwarecenter.qualcomm.com/catalog/item/Qualcomm_Security_Tools).
QCOM_SECTOOLS=
QCOM_SECTOOLS_VERSION=1.50.0
#QCOM_SECTOOLS_DIR=.sectools
#QCOM_SECTOOLS_URL=
#QCOM_SECTOOLS_SHA256=

# VIP (Validated Image Programming) table, generated by sign-build.
#QCOM_VIP_DISABLE=1
QCOM_VIP_DIR=$(QCOM_SIGNED_BUILD)/vip-tables
QCOM_FIREHOSE=prog_firehose_ddr.elf

# Target storage for `make flash` (emmc|nand|nvme|spinor|ufs).
QCOM_STORAGE=ufs

# qdl: empty QCOM_QDL clones QCOM_QDL_VERSION (branch or tag) and builds
# it into ./.qdl/<ref>/.
QCOM_QDL=
QCOM_QDL_VERSION=v2.8
#QCOM_QDL_REPO=https://github.com/linux-msm/qdl.git

# Fuse identifiers.  Required by: gen-fuse-blower.
QCOM_FUSE_OEM_HW_ID=
QCOM_FUSE_OEM_PRODUCT_ID=
QCOM_FUSE_SEC_KEY_DERIVATION_KEY=
